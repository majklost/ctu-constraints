{
  // Use Ruff for everything (Linting + Formatting)
  "python.analysis.importFormat": "relative",
  "python.analysis.exclude": [
    "**/node_modules",
    "**/__pycache__",
    "**/.venv",
    "**/venv",
    "**/env",
    "**/data", // Exclude your image datasets!
    "**/datasources", // Exclude your image datasets!
    "**/logs",
    "**/models" // Exclude saved model weights (.pth, .h5)
  ],
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "never",
      "source.organizeImports.ruff": "explicit"
    }
  },
  // Pyright (via Pylance language server) is used for real-time type checking
  "python.linting.mypyEnabled": false,
  "python.linting.enabled": true,
  "jupyter.runStartupCommands": [
    "%matplotlib inline",
    "import matplotlib.pyplot as plt"
  ],

  // Tell VS Code to use the uv-installed tools
  "ruff.importStrategy": "fromEnvironment",
  "python.terminal.activateEnvInCurrentTerminal": true,
  "python.languageServer": "Pylance",
  "python.analysis.typeCheckingMode": "standard",
  "python.analysis.useLibraryCodeForTypes": true,
  "python.analysis.indexing": true,
  "python.analysis.inlayHints.variableTypes": true,
  "python.analysis.inlayHints.functionReturnTypes": true,
  "editor.inlayHints.enabled": "on",
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.analysis.extraPaths": ["${workspaceFolder}"],
  "python.analysis.autoImportCompletions": true, // This helps Pylance find your 'carotide' package and libraries
  "jupytextSync.pythonExecutable": "${workspaceFolder}/.venv/bin/python",
  "jupytextSync.defaultFormats": {
    "py": "ipynb,py:percent"
  },
  "jupytextSync.askFormats": {
    "onPairDocuments": false
  },
  "jupytextSync.deleteOnNotebookClose": "if auto created",
  "workbench.editorAssociations": {
    "notebooks/**/*.py": "jupytextSync.pairedNotebookEditor"
  }
}
